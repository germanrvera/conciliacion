[credentials.usernames.admin]
email = "admin@tuempresa.com"
name = "Administrador"
password = "$2b$12$HASH_BCRYPT_AQUI"

[credentials.usernames.usuario1]
email = "usuario1@tuempresa.com"
name = "Nombre Apellido"
password = "$2b$12$HASH_BCRYPT_AQUI"

[cookie]
expiry_days = 1
key = "clave_secreta_unica_cambiar_esto"
name = "conciliacion_auth"
